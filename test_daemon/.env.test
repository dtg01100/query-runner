# Test-only env file for daemon test suite.
# Loaded via `query_runner --env-file test_daemon/.env.test` so the daemon tests
# don't accidentally hit a real AS/400 db2 endpoint when run from a checkout
# where .env points at production.
#
# All daemon tests run against a local sqlite DB (test_daemon.db) built from
# fixtures/test_schema.sql. The two queries that exercise real-database paths
# are in test_input_validation.sh and friends under test/, not here.

DB_TYPE=sqlite
DB_DATABASE=test_daemon/test_daemon.db
DB_USER=
DB_PASSWORD=

JDBC_DRIVER_CLASS=org.sqlite.JDBC
JDBC_URL=jdbc:sqlite:test_daemon/test_daemon.db
JDBC_JAR_PATH=drivers/sqlite-jdbc-3.51.0.0.jar
