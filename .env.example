# Copy this file to .env and fill in your connection details.
# Lines starting with # are comments. Blank lines are ignored.
# Every KEY=value line is loaded into the script's environment (only lines
# with a valid identifier name on the left-hand side are accepted), so
# remove or comment out anything you don't want exported.

# Database Type — leave blank for auto-detection from JDBC_URL / drivers dir.
# Supported: mysql, postgresql, oracle, sqlserver, db2, h2, sqlite
DB_TYPE=

# Connection settings. For SQLite, only DB_DATABASE is required and points
# at the .db file path (or :memory: / a file: URI).
DB_HOST=localhost
DB_PORT=
DB_DATABASE=
DB_USER=
DB_PASSWORD=

# Optional: connection / socket timeout in seconds (default: 30).
# Applies to network DBs (mysql, postgresql, oracle, sqlserver, db2).
DB_TIMEOUT=30

# Optional: override JDBC driver class / URL. When unset, the wrapper builds
# these from DB_TYPE + the values above.
# JDBC_DRIVER_CLASS=
# JDBC_URL=

# Optional: comma-separated whitelist of tables allowed in UNION queries.
# Without this, UNIONs across different tables are rejected by default.
# ALLOW_UNION_TABLES=users,logs